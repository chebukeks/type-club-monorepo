# ── Local development environment ──
# Copy this file to .env.local before starting local dev:
#   cp .env.local.example .env.local

# ── Database ──
DATABASE_URL=postgresql+asyncpg://typeclub:typeclub_pass@postgres:5432/typeclub_db

# ── Security ──
JWT_SECRET_KEY=dev-jwt-secret-not-for-production-use
SECRET_KEY=dev-secret-key-not-for-production-use

# ── SMTP (Mailpit — catch emails at http://localhost:8025) ──
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost
SMTP_USE_TLS=false
SMTP_START_TLS=false

# ── URLs ──
FRONTEND_URL=http://localhost:5173

# ── Misc ──
DEBUG=true
LOG_LEVEL=DEBUG
API_HOST=0.0.0.0
API_PORT=8000

# ── Collaboration ──
SERVICE_TOKEN=dev-token
