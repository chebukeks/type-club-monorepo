# ── Database ──
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/typeclub_db

# ── Security ──
# JWT signing key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-secret
# Application secret key
SECRET_KEY=change-me-to-a-random-secret

# ── SMTP (for email verification & password reset) ──
# Mailtrap Email Sending (production) example:
#   SMTP_HOST=live.smtp.mailtrap.io
#   SMTP_PORT=587
#   SMTP_USER=api
#   SMTP_PASS=<your Mailtrap token>
#   SMTP_FROM=support@type-club.ru   (must be on a verified sending domain)
#   SMTP_USE_TLS=false
#   SMTP_START_TLS=true
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com
# TLS mode: implicit TLS (port 465) OR STARTTLS (port 587/2525). Set exactly one.
SMTP_USE_TLS=false
SMTP_START_TLS=true

# ── URLs ──
# Frontend base URL (used for links in emails)
FRONTEND_URL=http://localhost:5173
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://type-club.ru

# ── Misc ──
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Collaboration (shared secret for backend ↔ collab-server) ──
# Generate with: openssl rand -hex 32
SERVICE_TOKEN=change-me-to-a-random-secret
