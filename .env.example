# ── Database ──
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/typeclub_db

# ── Security ──
# JWT signing key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-secret
# Application secret key
SECRET_KEY=change-me-to-a-random-secret

# ── SMTP (for email verification & password reset) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# ── URLs ──
# Frontend base URL (used for links in emails)
FRONTEND_URL=http://localhost:5173

# ── Misc ──
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Collaboration (shared secret for backend ↔ collab-server) ──
# Generate with: openssl rand -hex 32
SERVICE_TOKEN=change-me-to-a-random-secret
