{
  "name": "type-club",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:desktop": "npm run dev -w apps/desktop",
    "dev:desktop:local": "npm run dev:local -w apps/desktop",
    "build:web": "npm run build -w apps/web",
    "build:desktop": "npm run build -w apps/desktop",
    "build:desktop:mac": "npm run build:mac -w apps/desktop",
    "build": "npm run build:web && npm run build:desktop",
    "test": "tsx --test apps/desktop/src/utils/__tests__/*.test.ts packages/editor/src/**/__tests__/*.test.ts apps/web/src/**/__tests__/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "fast-uri": "^3.1.8",
    "dompurify": "^3.4.17",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2",
    "js-yaml": "^4.3.2",
    "browserslist": "^4.28.7",
    "baseline-browser-mapping": "^2.11.0",
    "tar": "^7.5.20",
    "config-file-ts": {
      "glob": "^10.5.0"
    },
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@5": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@9": {
      "brace-expansion": "^2.1.7"
    },
    "katex": "^0.18.11",
    "markdown-it": "^14.3.1",
    "prosemirror-view": "^1.42.6",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "@electron/get": "^5.1.0",
    "global-agent": {
      "roarr": "^7.21.7"
    },
    "roarr": "^7.21.7",
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    },
    "esbuild": "^0.25.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.2"
  }
}
