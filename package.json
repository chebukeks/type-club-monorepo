{
  "name": "type-club",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:desktop": "npm run dev -w apps/desktop",
    "dev:desktop:local": "npm run dev:local -w apps/desktop",
    "build:web": "npm run build -w apps/web",
    "build:desktop": "npm run build -w apps/desktop",
    "build:desktop:mac": "npm run build:mac -w apps/desktop",
    "build": "npm run build:web && npm run build:desktop"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.2"
  }
}
