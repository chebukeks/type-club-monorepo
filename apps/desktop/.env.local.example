# Раскомментируй, чтобы подключиться к локальному бэкенду
# (нужно сначала поднять бэкенд: docker compose -f docker-compose.local.yml up)
# VITE_SITE_URL=http://localhost:8000

# WebSocket URL для collab-сервера (определяется автоматически из VITE_SITE_URL,
# но можно переопределить вручную)
