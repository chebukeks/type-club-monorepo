{
  "name": "type-club",
  "private": true,
  "version": "0.9.7",
  "description": "A modern Markdown editor with LaTeX support.",
  "author": "chebukek",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "cross-env VITE_SITE_URL=http://localhost:8000 vite",
    "build": "tsc && vite build && electron-builder --linux --win",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:all": "tsc && vite build && electron-builder --linux --win --mac",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "lint": "eslint . --ext ts,tsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@type-club/editor": "*",
    "@types/katex": "^0.16.8",
    "an-array-of-english-words": "^2.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-ru": "^3.0.0",
    "electron-store": "^11.0.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.0",
    "lucide-react": "^1.6.0",
    "markdown-it": "^14.3.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "marked": "^17.0.5",
    "mermaid": "^12.2.0",
    "nspell": "^2.1.5",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.11.0",
    "prosemirror-view": "^1.42.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "42.11.18",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^6.4.4",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "@electron/get": {
      "global-agent": "^4.1.3"
    }
  },
  "main": "dist-electron/main.js"
