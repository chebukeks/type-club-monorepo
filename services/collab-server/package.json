    "markdown-it-task-lists": "^2",
    "markdown-it-texmath": "^1",
    "prosemirror-markdown": "^1",
    "prosemirror-model": "^1",
    "prosemirror-schema-list": "^1",
    "prosemirror-tables": "^1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "y-prosemirror": "^1.2",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "esbuild": "^0.21.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
